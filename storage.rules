rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to normalize authenticated user id across token shapes
    function authUid() {
      return request.auth.uid != null
        ? request.auth.uid
        : (request.auth.token.sub != null ? request.auth.token.sub : request.auth.token.user_id);
    }
    
    // Helper function to check file size (max 5MB)
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    
    // Helper function to check if file is an image
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Helper function to check if user is in the conversation
    function isConversationParticipant(conversationId) {
          return isAuthenticated() &&
            firestore.exists(/databases/(default)/documents/conversations/$(conversationId)) &&
             firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds.hasAny([authUid()]);
    }
    
    // Profile photos
    match /profile-photos/{userId}/{fileName} {
      // Anyone authenticated can view profile photos
      allow read: if isAuthenticated();
      
      // Only the user can upload their own profile photo
      allow write: if isAuthenticated() && 
                     authUid() == userId &&
                     isImage() &&
                     isValidSize();
      
      // Only the user can delete their own profile photo
      allow delete: if isAuthenticated() && 
                      authUid() == userId;
    }
    
    // Session photos (for climb photos)
    match /session-photos/{userId}/{sessionId}/{fileName} {
      // User can read their own session photos
      allow read: if isAuthenticated() && 
                    authUid() == userId;
      
      // User can upload photos to their sessions
      allow write: if isAuthenticated() && 
                     authUid() == userId &&
                     isImage() &&
                     isValidSize();
      
      // User can delete their session photos
      allow delete: if isAuthenticated() && 
                      authUid() == userId;
    }
    
    // Chat images (shared in conversations)
    match /chat-images/{conversationId}/{fileName} {
      // Only conversation participants can access chat images
      allow read: if isConversationParticipant(conversationId);

      // Only participants can upload valid chat images
      allow write: if isConversationParticipant(conversationId) &&
                     isImage() &&
                     isValidSize();
    }
  }
}
