rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is participant in conversation
    function isParticipant(conversationData) {
      return isAuthenticated() && 
             request.auth.uid in conversationData.participantIds;
    }

    // Helper: check whether the current user owns a session document
    function isSessionOwner(sessionId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read basic user info
      allow read: if isAuthenticated();
      
      // Only the user can write their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // Profiles collection
    match /profiles/{userId} {
      // Anyone authenticated can read profiles (for discovery)
      allow read: if isAuthenticated();
      
      // Only the user can write their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // Achievements subcollection
      match /achievements/{achievementId} {
        // Anyone authenticated can read achievements (to see on profiles)
        allow read: if isAuthenticated();
        
        // Only the user can write their own achievements
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // Stats subcollection (messaging stats, etc.)
      match /stats/{statId} {
        // Only the user can read/write their own stats
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
    
    // Sessions collection
    match /sessions/{sessionId} {
      // Users can only read their own sessions
      allow read: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
      
      // Users can create sessions for themselves
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Users can update/delete their own sessions
      allow update, delete: if isAuthenticated() && 
                              resource.data.userId == request.auth.uid;
    }
    
    // Climbs collection (individual climbs within sessions)
    match /climbs/{climbId} {
      // Users can only access climbs tied to sessions they own
      allow read: if isSessionOwner(resource.data.sessionId);

      // Users can only create climbs for their own sessions
      allow create: if request.resource.data.sessionId is string &&
                      isSessionOwner(request.resource.data.sessionId);

      // Users can only update/delete climbs tied to sessions they own
      allow update, delete: if isSessionOwner(resource.data.sessionId);
    }
    
    // Matches collection
    match /matches/{matchId} {
      // Users can read matches where they are involved
      allow read: if isAuthenticated() && 
                    (resource.data.userId == request.auth.uid || 
                     resource.data.matchedUserId == request.auth.uid);
      
      // Users can create matches
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Users can update matches they're involved in
      allow update: if isAuthenticated() && 
                      (resource.data.userId == request.auth.uid || 
                       resource.data.matchedUserId == request.auth.uid);
      
      // Users can delete matches they created
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
    
    // Conversations collection
    match /conversations/{conversationId} {
      // Participants can read the conversation
      allow read: if isParticipant(resource.data);
      
      // Authenticated users can create conversations
      allow create: if isAuthenticated() && 
                      request.auth.uid in request.resource.data.participantIds;
      
      // Participants can update conversation (e.g., read receipts)
      allow update: if isParticipant(resource.data);
      
      // Participants can delete conversation
      allow delete: if isParticipant(resource.data);
      
      // Messages subcollection
      match /messages/{messageId} {
        // Conversation participants can read messages
        allow read: if isAuthenticated() && 
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // Participants can send messages
        allow create: if isAuthenticated() && 
                        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                        request.resource.data.senderId == request.auth.uid;
        
        // Participants can update messages (for read receipts) or sender can edit their message
        allow update: if isAuthenticated() && 
                        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // Message sender can delete their own message
        allow delete: if isAuthenticated() && 
                        resource.data.senderId == request.auth.uid;
      }
    }
    
    // Discovery/potential matches collection (for the discover feature)
    match /potentialMatches/{matchId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Gyms collection (climbing gyms and outdoor locations)
    match /gyms/{gymId} {
      // Anyone authenticated can read gym data
      allow read: if isAuthenticated();
      
      // Authenticated users can add new gyms
      allow create: if isAuthenticated();
      
      // Anyone authenticated can update gym (increment session count, etc.)
      allow update: if isAuthenticated();
      
      // Only the user who added the gym can delete it
      allow delete: if isAuthenticated() && 
                      resource.data.addedBy == request.auth.uid;
    }
    
    // Schedules collection (user climbing availability)
    match /schedules/{userId} {
      // Anyone authenticated can read schedules (for finding overlaps with connections)
      allow read: if isAuthenticated();
      
      // Only the user can write their own schedule
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}
