rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to normalize authenticated user id across token shapes
    function authUid() {
      return request.auth.uid != null
        ? request.auth.uid
        : (request.auth.token.sub != null ? request.auth.token.sub : request.auth.token.user_id);
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && authUid() == userId;
    }

    // Verified email is required for social features that expose or contact other users.
    function hasVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isModerator() {
      return isAuthenticated() &&
             (
               ('admin' in request.auth.token && request.auth.token.admin == true) ||
               ('moderator' in request.auth.token && request.auth.token.moderator == true)
             );
    }

    function moderationPath(userId) {
      return /databases/$(database)/documents/userModeration/$(userId);
    }

    function isSuspended(userId) {
      return exists(moderationPath(userId)) &&
             get(moderationPath(userId)).data.status == 'suspended';
    }

    function hasActiveMute(userId) {
      return exists(moderationPath(userId)) &&
             get(moderationPath(userId)).data.status == 'muted' &&
             (
               get(moderationPath(userId)).data.mutedUntil == null ||
               get(moderationPath(userId)).data.mutedUntil > request.time
             );
    }

    function canUseSocialFeatures() {
      return hasVerifiedEmail() && !isSuspended(authUid());
    }
    
    // Helper function to check if user is participant in conversation
    function isParticipant(conversationData) {
      return isAuthenticated() && 
             authUid() in conversationData.participantIds;
    }

    // Helper: check whether the current user owns a session document
    function isSessionOwner(sessionId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == authUid();
    }

    function preservesFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function textOrNull(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validUserDoc(userId) {
      return request.resource.data.keys().hasOnly([
               'uid',
               'email',
               'displayName',
               'photoURL',
               'emailVerified',
               'createdAt',
               'lastLoginAt',
               'updatedAt'
             ]) &&
             request.resource.data.uid == userId &&
             textOrNull(request.resource.data.email, 254) &&
             textOrNull(request.resource.data.displayName, 80) &&
             textOrNull(request.resource.data.photoURL, 2000);
    }

    function validProfileDoc(userId) {
      return request.resource.data.keys().hasOnly([
               'uid',
               'displayName',
               'photoURL',
               'bio',
               'location',
               'geoPoint',
               'experienceLevel',
               'climbingTypes',
               'highestGradeYDS',
               'highestGradeBouldering',
               'preferredClimbingStyle',
               'partnerPreferences',
               'availableDays',
               'availableTimes',
               'homeGym',
               'city',
               'favoriteOutdoorAreas',
               'yearsClimbing',
               'certifications',
               'isProfileComplete',
               'isSearchable',
               'emailNotifications',
               'emailNotificationTypes',
               'createdAt',
               'updatedAt'
             ]) &&
             request.resource.data.uid == userId &&
             textOrNull(request.resource.data.displayName, 80) &&
             textOrNull(request.resource.data.photoURL, 2000) &&
             textOrNull(request.resource.data.bio, 1000) &&
             textOrNull(request.resource.data.preferredClimbingStyle, 120) &&
             textOrNull(request.resource.data.homeGym, 160) &&
             textOrNull(request.resource.data.city, 120) &&
             (request.resource.data.yearsClimbing == null ||
               (request.resource.data.yearsClimbing is number &&
                request.resource.data.yearsClimbing >= 0 &&
                request.resource.data.yearsClimbing <= 80));
    }

    function validSessionDoc(userId) {
      return request.resource.data.keys().hasOnly([
               'userId',
               'date',
               'location',
               'locationType',
               'duration',
               'notes',
               'photos',
               'climbs',
               'createdAt',
               'updatedAt'
             ]) &&
             request.resource.data.userId == userId &&
             textOrNull(request.resource.data.location, 160) &&
             textOrNull(request.resource.data.notes, 2000) &&
             request.resource.data.locationType in ['indoor', 'outdoor'] &&
             request.resource.data.duration is number &&
             request.resource.data.duration >= 0 &&
             request.resource.data.duration <= 1440;
    }

    function validClimbDoc(sessionId) {
      return request.resource.data.keys().hasOnly([
               'sessionId',
               'name',
               'grade',
               'gradeSystem',
               'climbingType',
               'result',
               'attempts',
               'notes',
               'rating',
               'photos',
               'createdAt'
             ]) &&
             request.resource.data.sessionId == sessionId &&
             textOrNull(request.resource.data.name, 160) &&
             textOrNull(request.resource.data.grade, 20) &&
             textOrNull(request.resource.data.climbingType, 80) &&
             textOrNull(request.resource.data.result, 40) &&
             textOrNull(request.resource.data.notes, 2000) &&
             request.resource.data.gradeSystem in ['yds', 'v-scale'] &&
             request.resource.data.attempts is number &&
             request.resource.data.attempts >= 0 &&
             request.resource.data.attempts <= 100 &&
             request.resource.data.rating is number &&
             request.resource.data.rating >= 0 &&
             request.resource.data.rating <= 5;
    }

    function validScheduleDoc(userId) {
      return request.resource.data.keys().hasOnly([
               'userId',
               'schedule',
               'preferredGyms',
               'notes',
               'createdAt',
               'updatedAt'
             ]) &&
             request.resource.data.userId == userId &&
             textOrNull(request.resource.data.notes, 1000);
    }

    function validMessageDoc(conversationId) {
      return request.resource.data.keys().hasOnly([
               'conversationId',
               'senderId',
               'text',
               'imageUrl',
               'readBy',
               'createdAt'
             ]) &&
             request.resource.data.conversationId == conversationId &&
             request.resource.data.senderId == authUid() &&
             textOrNull(request.resource.data.text, 2000) &&
             textOrNull(request.resource.data.imageUrl, 2000);
    }

    function validReportDoc() {
      return request.resource.data.keys().hasOnly([
               'reporterId',
               'targetType',
               'reason',
               'details',
               'status',
               'reportedUserId',
               'conversationId',
               'messageId',
               'messagePreview',
               'createdAt',
               'updatedAt'
             ]) &&
             request.resource.data.reporterId == authUid() &&
             request.resource.data.targetType in ['user', 'message'] &&
             request.resource.data.reason in [
               'harassment',
               'hate_speech',
               'sexual_content',
               'spam',
               'impersonation',
               'safety_concern',
               'other'
             ] &&
             request.resource.data.status == 'pending' &&
             textOrNull(request.resource.data.details, 2000) &&
             textOrNull(request.resource.data.messagePreview, 280) &&
             (
               (
                 request.resource.data.targetType == 'user' &&
                 request.resource.data.reportedUserId is string &&
                 request.resource.data.reportedUserId != authUid()
               ) ||
               (
                 request.resource.data.targetType == 'message' &&
                 request.resource.data.conversationId is string &&
                 request.resource.data.messageId is string &&
                 isParticipant(get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data)
               )
             );
    }

    function validReportReviewUpdate() {
      return isModerator() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status',
               'reviewedAt',
               'reviewedBy',
               'moderatorNotes',
               'updatedAt'
             ]) &&
             request.resource.data.status in ['pending', 'reviewed', 'dismissed', 'action_taken'] &&
             request.resource.data.reviewedBy == authUid() &&
             textOrNull(request.resource.data.moderatorNotes, 2000);
    }

    function validModerationActionDoc() {
      return request.resource.data.keys().hasOnly([
               'targetUserId',
               'moderatorId',
               'action',
               'reason',
               'reportId',
               'durationMinutes',
               'expiresAt',
               'createdAt'
             ]) &&
             request.resource.data.moderatorId == authUid() &&
             request.resource.data.targetUserId is string &&
             request.resource.data.targetUserId != authUid() &&
             request.resource.data.action in ['warn', 'mute', 'suspend', 'lift'] &&
             textOrNull(request.resource.data.reason, 2000) &&
             textOrNull(request.resource.data.reportId, 160) &&
             (
               request.resource.data.durationMinutes == null ||
               (
                 request.resource.data.durationMinutes is number &&
                 request.resource.data.durationMinutes >= 1 &&
                 request.resource.data.durationMinutes <= 43200
               )
             );
    }

    function validUserModerationDoc(userId) {
      return request.resource.data.keys().hasOnly([
               'userId',
               'status',
               'reason',
               'mutedUntil',
               'updatedAt',
               'updatedBy',
               'lastActionId'
             ]) &&
             request.resource.data.userId == userId &&
             request.resource.data.status in ['active', 'warned', 'muted', 'suspended'] &&
             request.resource.data.updatedBy == authUid() &&
             textOrNull(request.resource.data.reason, 2000) &&
             textOrNull(request.resource.data.lastActionId, 160);
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read basic user info
      allow read: if isAuthenticated();
      
      // Only the user can write their own profile
      allow create: if isOwner(userId) && validUserDoc(userId);
      allow update: if isOwner(userId) &&
                      validUserDoc(userId) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }
    
    // Profiles collection
    match /profiles/{userId} {
      // Users can read their own profile before verification; discovery requires verification.
      allow read: if isOwner(userId) || hasVerifiedEmail();
      
      // Only the user can write their own profile
      allow create: if isOwner(userId) && validProfileDoc(userId);
      allow update: if isOwner(userId) &&
                      validProfileDoc(userId) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
      
      // Achievements subcollection
      match /achievements/{achievementId} {
        // Anyone authenticated can read achievements (to see on profiles)
        allow read: if isAuthenticated();
        
        // Spark beta: achievements are primarily derived client-side; owners can remove their own legacy records.
        allow create: if false;
        allow update: if isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notified']) &&
                        request.resource.data.achievementId == resource.data.achievementId &&
                        request.resource.data.progress == resource.data.progress &&
                        request.resource.data.unlockedAt == resource.data.unlockedAt &&
                        request.resource.data.notified == true;
        allow delete: if isOwner(userId);
      }
      
      // Stats subcollection (messaging stats, etc.)
      match /stats/{statId} {
        // Private stat docs are read-only for owners during Spark beta.
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    // User-submitted moderation reports
    match /reports/{reportId} {
      allow read: if (isAuthenticated() && resource.data.reporterId == authUid()) || isModerator();
      allow create: if hasVerifiedEmail() && validReportDoc();
      allow update: if validReportReviewUpdate();
      allow delete: if false;
    }

    // Immutable moderation audit log
    match /moderationActions/{actionId} {
      allow read: if isModerator();
      allow create: if isModerator() && validModerationActionDoc();
      allow update, delete: if false;
    }

    // Current enforcement state per user
    match /userModeration/{userId} {
      allow read: if isOwner(userId) || isModerator();
      allow create, update: if isModerator() && validUserModerationDoc(userId);
      allow delete: if false;
    }
    
    // Sessions collection
    match /sessions/{sessionId} {
      // Users can only read their own sessions
      allow read: if isAuthenticated() && 
                    resource.data.userId == authUid();
      
      // Users can create sessions for themselves
      allow create: if isAuthenticated() && 
                      validSessionDoc(authUid());
      
      // Users can update/delete their own sessions
      allow update: if isAuthenticated() &&
                      resource.data.userId == authUid() &&
                      validSessionDoc(authUid()) &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() &&
                      resource.data.userId == authUid();
    }
    
    // Climbs collection (individual climbs within sessions)
    match /climbs/{climbId} {
      // Users can only access climbs tied to sessions they own
      allow read: if isSessionOwner(resource.data.sessionId);

      // Users can only create climbs for their own sessions
      allow create: if request.resource.data.sessionId is string &&
                      isSessionOwner(request.resource.data.sessionId) &&
                      validClimbDoc(request.resource.data.sessionId);

      // Users can only update/delete climbs tied to sessions they own
      allow update: if isSessionOwner(resource.data.sessionId) &&
                      validClimbDoc(resource.data.sessionId) &&
                      request.resource.data.sessionId == resource.data.sessionId;
      allow delete: if isSessionOwner(resource.data.sessionId);
    }
    
    // Matches collection
    match /matches/{matchId} {
      // Users can read matches where they are involved
      allow read: if canUseSocialFeatures() &&
                    (resource.data.userId == authUid() || 
                     resource.data.matchedUserId == authUid());
      
      // Users can create matches
      allow create: if canUseSocialFeatures() &&
                      request.resource.data.userId == authUid() &&
                      request.resource.data.keys().hasOnly([
                        'userId',
                        'matchedUserId',
                        'status',
                        'initiatedBy',
                        'createdAt',
                        'updatedAt'
                      ]) &&
                      request.resource.data.initiatedBy == authUid();
      
      // Users can update matches they're involved in
      allow update: if canUseSocialFeatures() &&
                      (resource.data.userId == authUid() || 
                       resource.data.matchedUserId == authUid()) &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.matchedUserId == resource.data.matchedUserId &&
                      request.resource.data.initiatedBy == resource.data.initiatedBy &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.keys().hasOnly([
                        'userId',
                        'matchedUserId',
                        'status',
                        'initiatedBy',
                        'createdAt',
                        'updatedAt'
                      ]);
      
      // Involved users can remove matches during Spark beta account cleanup.
      allow delete: if canUseSocialFeatures() &&
                      (resource.data.userId == authUid() ||
                       resource.data.matchedUserId == authUid());
    }
    
    // Conversations collection
    match /conversations/{conversationId} {
      // Participants can read the conversation
      allow read: if canUseSocialFeatures() && isParticipant(resource.data);
      
      // Authenticated users can create conversations
      allow create: if canUseSocialFeatures() &&
                      authUid() in request.resource.data.participantIds &&
                      request.resource.data.participantIds.size() == 2 &&
                      request.resource.data.keys().hasOnly([
                        'participantIds',
                        'participants',
                        'lastMessage',
                        'lastMessageAt',
                        'createdAt',
                        'updatedAt'
                      ]);
      
      // Participants can update conversation (e.g., read receipts)
      allow update: if canUseSocialFeatures() && isParticipant(resource.data) &&
                      request.resource.data.participantIds == resource.data.participantIds &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.keys().hasOnly([
                        'participantIds',
                        'participants',
                        'lastMessage',
                        'lastMessageAt',
                        'createdAt',
                        'updatedAt'
                      ]);
      
      // Participants can delete conversation
      allow delete: if canUseSocialFeatures() && isParticipant(resource.data);
      
      // Messages subcollection
      match /messages/{messageId} {
        // Conversation participants can read messages
        allow read: if canUseSocialFeatures() &&
                      authUid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // Participants can send messages
        allow create: if canUseSocialFeatures() &&
                        !hasActiveMute(authUid()) &&
                        authUid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                        validMessageDoc(conversationId) &&
                        request.resource.data.readBy.size() == 1 &&
                        authUid() in request.resource.data.readBy;
        
        // Participants can update messages (for read receipts) or sender can edit their message
        allow update: if canUseSocialFeatures() &&
                        authUid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                        request.resource.data.senderId == resource.data.senderId &&
                        request.resource.data.conversationId == resource.data.conversationId &&
                        request.resource.data.text == resource.data.text &&
                        request.resource.data.imageUrl == resource.data.imageUrl &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.keys().hasOnly([
                          'conversationId',
                          'senderId',
                          'text',
                          'imageUrl',
                          'readBy',
                          'createdAt'
                        ]) &&
                        authUid() in request.resource.data.readBy;
        
        // Message sender can delete their own message
        allow delete: if canUseSocialFeatures() &&
                        resource.data.senderId == authUid();
      }
    }
    
    // Discovery/potential matches collection (for the discover feature)
    match /potentialMatches/{matchId} {
      allow read: if canUseSocialFeatures() && resource.data.userId == authUid();
      allow create: if canUseSocialFeatures() &&
                      request.resource.data.userId == authUid() &&
                      request.resource.data.keys().hasOnly(['userId', 'score', 'createdAt', 'updatedAt']);
      allow update: if canUseSocialFeatures() &&
                      resource.data.userId == authUid() &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if canUseSocialFeatures() && resource.data.userId == authUid();
    }
    
    // Gyms collection (climbing gyms and outdoor locations)
    match /gyms/{gymId} {
      // Anyone authenticated can read gym data
      allow read: if isAuthenticated();
      
      // Verified users can add new gyms with constrained fields.
      allow create: if hasVerifiedEmail() &&
                      request.resource.data.addedBy == authUid() &&
                      request.resource.data.sessionCount == 0 &&
                      request.resource.data.verified == false &&
                      request.resource.data.keys().hasOnly([
                        'id',
                        'name',
                        'address',
                        'city',
                        'state',
                        'country',
                        'placeId',
                        'location',
                        'type',
                        'category',
                        'chain',
                        'amenities',
                        'verified',
                        'addedBy',
                        'sessionCount',
                        'createdAt',
                        'updatedAt'
                      ]);
      
      // Gym popularity counters are disabled during Spark beta; creators can correct basic listing details.
      allow update: if hasVerifiedEmail() &&
                      resource.data.addedBy == authUid() &&
                      request.resource.data.addedBy == resource.data.addedBy &&
                      request.resource.data.verified == resource.data.verified &&
                      request.resource.data.sessionCount == resource.data.sessionCount &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.keys().hasOnly([
                        'id',
                        'name',
                        'address',
                        'city',
                        'state',
                        'country',
                        'placeId',
                        'location',
                        'type',
                        'category',
                        'chain',
                        'amenities',
                        'verified',
                        'addedBy',
                        'sessionCount',
                        'createdAt',
                        'updatedAt'
                      ]);
      
      // Only the user who added the gym can delete it
      allow delete: if isAuthenticated() && 
                      resource.data.addedBy == authUid();
    }
    
    // Schedules collection (user climbing availability)
    match /schedules/{userId} {
      // Own schedule is available before verification; viewing others requires verification.
      allow read: if isOwner(userId) || hasVerifiedEmail();
      
      // Only the user can write their own schedule
      allow create: if isOwner(userId) && validScheduleDoc(userId);
      allow update: if isOwner(userId) &&
                      validScheduleDoc(userId) &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }
  }
}
