# Firebase Functions local environment template
# Do not commit real values. Set the production SMTP password with:
# firebase functions:secrets:set SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
FROM_EMAIL=Belay <notifications@example.com>

# Local emulator/development only. Production reads this from Secret Manager.
SMTP_PASS=your-local-smtp-app-password
